<?xml version="1.0" encoding="UTF-8"?>

<Window size="720,660" caption="0,0,0,52" roundcorner="12,12" >
  <Font name="Segoe UI" size="16" default="true" />
  <Font name="Segoe UI" size="16" />
  <Font name="Segoe UI" size="15" />
  <Font name="Segoe UI Semibold" size="12" />
  <Font name="Segoe UI Semibold" size="21" />
  <Font name="Segoe UI Semibold" size="15" />
  <Include source="styles.xml" />

  <Class name="Title" bkcolor="#FF1E1F24" />
  <Class name="LabelTitle" font="3" textcolor="#FF8B90A0" height="28" textpadding="2,0,2,4" align="left"
    bkimage="file='Common/kf/line.png' dest='0,27,2000,28'" />
  <Class name="ListLabelElement" />
  <Class name="Background" bkcolor="#FF1E1F24" />
  <Class name="TabSelect" font="5" align="left" textpadding="18,0,0,0"
    textcolor="#FFA4A9B6" selectedtextcolor="#FFFFFFFF" hottextcolor="#FFE4E6EB" focusedtextcolor="#FFA4A9B6" pushedtextcolor="#FFE4E6EB" selectedpushedtextcolor="#FFFFFFFF"
    hotimage            = "file='Common/kf/tab_hot.png' corner='10,10,10,10'"
    pushedimage         = "file='Common/kf/tab_hot.png' corner='10,10,10,10'"
    selectedimage       = "file='Common/kf/tab_sel.png' corner='10,10,10,10'"
    selectedhotimage    = "file='Common/kf/tab_sel.png' corner='10,10,10,10'"
    selectedpushedimage = "file='Common/kf/tab_sel.png' corner='10,10,10,10'"
  />

  <VerticalLayout class="Title" inset="0,0,0,0" >
    <HorizontalLayout height="52" bkcolor="#FF17181C" inset="24,0,24,0" childpadding="10" >
      <Label text="KFWE" font="4" textcolor="#FF7C5CFF" width="64" height="52" align="left" textpadding="0,0,0,0" />
      <Label text="Настройки" font="0" textcolor="#FF8B90A0" height="52" align="left" textpadding="0,2,0,0" />
    </HorizontalLayout>
    <HorizontalLayout>
      <VerticalLayout bkcolor="#FFEAECEC" width="275" inset="6,4,0,4">
        <Control height="16" />
        <RadioButton name="tab_0" group="TabSelect" text="Компиляция Карты"   class="TabSelect" width="176" height="38" selected="true" />
        <Control height="4" />
        <RadioButton name="tab_1" group="TabSelect" text="Тестирование Карты"       class="TabSelect" width="176" height="38" />
        <Control height="4" />
        <RadioButton name="tab_2" group="TabSelect" text="Редактор" class="TabSelect" width="176" height="38" />
        <Control height="4" />
        <RadioButton name="tab_3" group="TabSelect" text="Тест в Локальной Сети" class="TabSelect" width="176" height="38" />
        <Control height="4" />
        <RadioButton name="tab_4" group="TabSelect" text="Плагины"   class="TabSelect" width="176" height="38" />
        <Control height="4" />
        <RadioButton name="tab_5" group="TabSelect" text="Системные Ассоциации"   class="TabSelect" width="176" height="38" />
        <Control height="4" />
        <RadioButton name="tab_6" group="TabSelect" text="Язык"       class="TabSelect" width="176" height="38" />
      </VerticalLayout>
      <TabLayout name="tabs" >
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="140" >
            <Label text="ВЕРСИЯ КАРТЫ ПРИ СОХРАНЕНИИ" tooltip= "Настройки версии карты" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <RadioButton class="NormalRadioButton" text="Стандарт (Ваша текущая версия wc3)"   width="412" group="MapSave" name="MapSave_0" tooltip="Сохранить такую же версию карты какую версию варкрафта вы указали для использовании этого редактора" />
              <RadioButton class="NormalRadioButton" text="Сохранить как старую （1.20）" width="412" group="MapSave" name="MapSave_1" tooltip="Сохранить как версию до 1.24" />
              <RadioButton class="NormalRadioButton" text="Сохранить как новую （1.24+）" width="412" group="MapSave" name="MapSave_2" tooltip="Сохранить как версию после 1.24 и любые после нее" />
            </VerticalLayout>
          </VerticalLayout>
          <Control height="12" />
          <VerticalLayout height="120" >
            <Label text="ИМПОРТ КОДА В КАРТУ" tooltip="Отвечает за импорт систем и функций KFWE, рекомендуется ставить автоматически" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <RadioButton class="NormalRadioButton" text="Автоматически" width="412" group="ScriptInjection" name="ScriptInjection_0" tooltip="Все встроенные системы и функции KFWE будут автоматически добавляться в код карты. Если вы используете их без автоматического импорта, вы будете получать ошибку &quot;Undeclared Function&quot;" />
              <RadioButton class="NormalRadioButton" text="Вручную"   width="412" group="ScriptInjection" name="ScriptInjection_1" tooltip="Для ручного добавления используйте: #include &quot;Имя файла.j&quot; Пример: #include &quot;YDWEAttackWaveTimer.j&quot; Файлы находятся в ui\ydwe\jass. Вы так же можете создавать и импортировать собственные части кода." />
            </VerticalLayout>
          </VerticalLayout>
          <Control height="12" />
          <VerticalLayout height="140" >
            <Label text="КОМПИЛЯТОР СКРИПТОВ" tooltip="Опции связанные с JassHelper и cJass Compiler." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6"  >
              <CheckBox text="Включить JassHelper" width="244" name="EnableJassHelper" tooltip="Включает компилятор JassHelper. Компилятор JassHelper это то на чем базируются все функции KFWE, если вы его отключите, вы не сможете использовать ни одну уникальную функцию KFWE. Если вы не являетесь автором который использует чистый Jass без vJass, не отключайте эту опцию." />
              <CheckBox text="Включить Jass Helper Оптимизацию"         width="440" name="EnableJassHelperOptimization" tooltip="В настоящее время поддерживает встраивание функций." />
              <CheckBox text="Включить Jass Helper Дебагинг"         width="344" name="EnableJassHelperDebug" tooltip="Включить дебаг мод для карты. Влияет на пометки с &quot;#debug&quot; и оптимизацию кода." />
            </VerticalLayout>
          </VerticalLayout>
          <Control height="12" />
          <VerticalLayout height="110" >
            <Label text="ПРОВЕРКА ГРАММАТИКИ (PJASS)" tooltip="Опции связанные с PJass." class="LabelTitle" />
            <HorizontalLayout height="40" inset="10,6,10,6" >
              <RadioButton class="NormalRadioButton" text="Последний" width="122" group="PJass" name="PJass_0" tooltip="" />
              <RadioButton class="NormalRadioButton" text="Классический" width="132" group="PJass" name="PJass_1" tooltip="" />
            </HorizontalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="230" >
            <Label text="ОПЦИИ" tooltip="Опции для варкрафта при запуске тестирования карты через редактор." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text="Оконный Режим"     width="440" name="LaunchWindowed" tooltip="Запускает Warcraft 3 в оконном режиме." />
              <HorizontalLayout>
                <Control width="16" />
                <VerticalLayout>
                  <CheckBox text="Полный Экран"     width="244" name="LaunchFullWindowed"       tooltip="В оконном режиме у вас будет полный экран." />
                  <CheckBox text="Удерживать Курсор"       width="244" name="LaunchLockingMouse"       tooltip="Не позволяет курсору выйти за рамки игры в оконном режиме." />
                  <CheckBox text="Адаптивный Экран"   width="244" name="LaunchFixedRatioWindowed" tooltip="Позволяет игре автоматически адаптироваться под ваш экран, вместо растяжения." />
                </VerticalLayout>
                </HorizontalLayout>
              <CheckBox text="Широкоформатный Экран" width="274" name="LaunchWideScreenSupport" tooltip="Включает разрешение 16:9" />
              <CheckBox text="Отключить Безопасный Доступ" width="440" name="LaunchDisableSecurityAccess" tooltip="Warcraft увеличит свои собственные ограничения доступа, чтобы предотвратить доступ к нему всех неадминистративных процессов. После этого необходимы права VistaAdmin UAC，Разве это не раздражает?" />
            </VerticalLayout>
          </VerticalLayout>
          <VerticalLayout height="90" >
            <Label text="ТИП РЕНДЕРИНГА" tooltip="Вы можете выбрать способ рендеринга." class="LabelTitle" />
            <Control height="12" />
            <HorizontalLayout height="30" >
              <Control width="16" />
              <Combo name="LaunchRenderingEngine" itemfont="2" normalimage="file='Common/kf/field.png' corner='8,8,8,8'" hotimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" pushedimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" textpadding="10,0,10,0" itemtextcolor="#FFE4E6EB" itembkcolor="#FF2B2D33" itemhottextcolor="#FFFFFFFF" itemhotbkcolor="#FF363944" itemselectedtextcolor="#FFFFFFFF" itemselectedbkcolor="#FF7C5CFF" >
                <ListLabelElement text="Direct3D 8" />
                <ListLabelElement text="Direct3D 9" />
                <ListLabelElement text="OpenGL" />
              </Combo>
            </HorizontalLayout>
          </VerticalLayout>
          <Control height="12" />
          <VerticalLayout>
            <Label text="ВЕРСИЯ ИГРЫ ПРИ ТЕСТЕ КАРТЫ" tooltip="Вы можете выбрать версию игры для тестирования карты." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <RadioButton class="NormalRadioButton" text="Использовать Текущую Версию Игры"       width="312" group="War3Patch" name="War3Patch_0" tooltip="Использовать ту версию которую вы указали в пути к KFWE. Это самый лучший вариант." />
              <RadioButton class="NormalRadioButton" text="Адаптироваться Под Версию Карты" width="312" group="War3Patch" name="War3Patch_1" tooltip="Версия игры подстроится под версию карты если у вас есть соответствующая версия в каталоге патчей." />
              <RadioButton class="NormalRadioButton" text="Выбрать Конкретную Версию"           width="262" group="War3Patch" name="War3Patch_2" tooltip="Использовать специальную версию, если она у вас есть." />
              <HorizontalLayout>
                <Control width="16" />
                <VerticalLayout name ="War3PatchList" enabled="false" vscrollbar="true" height="90" >
                </VerticalLayout>
              </HorizontalLayout>
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="370" >
            <Label text="ОПЦИИ" tooltip= "Включение некоторых функций может иметь проблемы совместимости (но я таких никогда не встречал)." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text="Slk-Оптимизация Перед Тестом Карты" width="344" name="EnableMapSlk" tooltip="Перед каждым запуском тестирования карты через редактор, оптимизирует карту для ускорения её загрузки. Если Ваша карта грузится долго, это поможет очень сильно снизить скорость загрузки. На время тестирования, язык стандартного текста в карте, может быть изменен." />
                <HorizontalLayout height="24" >
                  <Control width="20" />
                  <RadioButton class="NormalRadioButton" text="KFMO (рекомендуется)" width="202" group="MapOptimizer" name="MapOptimizer_0" tooltip="Быстрее и без замены текстов стандартных объектов." />
                  <RadioButton class="NormalRadioButton" text="w3x2lni" width="122" group="MapOptimizer" name="MapOptimizer_1" tooltip="Старый оптимизатор." />
                </HorizontalLayout>
              <CheckBox text="Плагин Покраски Текста (*)"         width="294" name="EnableDotNetSupport" tooltip="Каждый раз когда вы редактируете текстовые поля в редакторе объектов, будет запущен плагин для удобной покраски цвета текста." />
              <CheckBox text="Подсветка Jass кода(TESH) (*)"     width="304" name="EnableTesh" tooltip="Включает TESH. Если редактор вылетает, отключите эту опцию." />
              <CheckBox text="Ускорение загрузки (экспериментально) (*)" width="384" name="EnableStormFastHeap" tooltip="Экспериментально. Ускоряет открытие и тест больших карт: быстрый менеджер памяти для строк, исправление квадратичного роста массива и индекс для проверки переменных триггеров. Если редактор ведёт себя странно, выключите. Требует перезапуска редактора." />
              <CheckBox text="Установить свой ID объекту"  width="344" name="EnableManualNewId" tooltip="Позволяет вводить свои собственные равкоды при создании объектов в редакторе объектов." />
              <CheckBox text="Не спрашивать про папки UI/Units" width="384" name="DisableUiDirCheck" tooltip="Не показывать при запуске вопрос об удалении папок UI и Units в папке Warcraft III." />
              <CheckBox text="Изменить Шрифт(*)" tooltip="Позволяет выбрать шрифт и его размер для отображения в редакторе объектов" width="244" name="FontEnable" />
              <HorizontalLayout>
                <Control width="20" />
                <Combo name="FontName" dropboxsize="0, 300" height="30" itemfont="2" normalimage="file='Common/kf/field.png' corner='8,8,8,8'" hotimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" pushedimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" textpadding="10,0,10,0" itemtextcolor="#FFE4E6EB" itembkcolor="#FF2B2D33" itemhottextcolor="#FFFFFFFF" itemhotbkcolor="#FF363944" itemselectedtextcolor="#FFFFFFFF" itemselectedbkcolor="#FF7C5CFF" />
                <Control width="20" />
                <Combo name="FontSize" width="60" height="30" itemfont="2" normalimage="file='Common/kf/field.png' corner='8,8,8,8'" hotimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" pushedimage="file='Common/kf/field_hot.png' corner='8,8,8,8'" textpadding="10,0,10,0" itemtextcolor="#FFE4E6EB" itembkcolor="#FF2B2D33" itemhottextcolor="#FFFFFFFF" itemhotbkcolor="#FF363944" itemselectedtextcolor="#FFFFFFFF" itemselectedbkcolor="#FF7C5CFF" >
                  <ListLabelElement text="8" />
                  <ListLabelElement text="9" />
                  <ListLabelElement text="10" />
                  <ListLabelElement text="11" />
                  <ListLabelElement text="12" />
                  <ListLabelElement text="13" />
                  <ListLabelElement text="14" />
                  <ListLabelElement text="15" />
                  <ListLabelElement text="16" />
                  <ListLabelElement text="17" />
                  <ListLabelElement text="18" />
                </Combo>
              </HorizontalLayout>
              <Label name="FontPreview" text="AaBbCc 0123456789 test" textcolor="#FFE4E6EB" align="center" height="80" />
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="290" >
            <Label text="ТЕСТ КАРТЫ В ЛОКАЛЬНОЙ СЕТИ"  tooltip="" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text="Включить LAN Тест"         width="244" name="EnableHost" tooltip="Карта будет запускаться в локальной сети вместо одиночной игры." />
                <VerticalLayout class="Background" inset="10,6,10,6" >
                  <RadioButton class="NormalRadioButton" text="Один Игрок" width="212" group="HostTest" name="HostTest_0" tooltip="Один игрок но карта запустится в локальной сети." />
                  <RadioButton class="NormalRadioButton" text="Несколько Игроков"   width="212" group="HostTest" name="HostTest_1" tooltip="Запустит столько окон сколько у вас в карте открытых для игроков слотов. Все окна будут заходить в созданную игру автоматически, но могут случайно зайти в меню загрузки игры, в этом случае вам надо выйти из этого меню и подождать пока он не зайдет в созданную игру." />
              </VerticalLayout>
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="450" >
            <Label text="ПЛАГИНЫ"  tooltip="Выберите нужные плагины, если вы новичек то можете выбрать все." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <HorizontalLayout>
                <Control width="16" />
                <VerticalLayout name ="War3PluginList" enabled="false" vscrollbar="true" height="400" >
                </VerticalLayout>
              </HorizontalLayout>
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" vscrollbar="true" >
          <VerticalLayout height="110" >
            <Label text="АССОЦИИРОВАТЬ КАРТЫ С KFWE"  tooltip="Двойным кликом вы сможете сразу открывать эти типы карт в редакторе KFWE, кроме того, они будут помечены специальной иконкой. Конфликтует с редактором Reforged." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text=".w3x" width="244" name="FileAssociation_w3x" tooltip="Карты Frozen Throne." />
              <CheckBox text=".w3m" width="244" name="FileAssociation_w3m" tooltip="Карты Reign of Chaos." />
            </VerticalLayout>
          </VerticalLayout>
          <Control height="16" />
          <VerticalLayout height="110" >
            <Label text="ЯРЛЫКИ"  tooltip="Добавить/удалить ярлыки для запуска KFWE." class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text="Добавить на рабочий стол"   width="294" name="Shortcuts_desktop" tooltip="Добавляет ярлык KFWE на рабочий стол." />
              <CheckBox text="Добавить в меню windows" width="244" name="Shortcuts_taskbar" tooltip="Добавляет ярлык KFWE в меню windows." />
            </VerticalLayout>
          </VerticalLayout>
          <Control height="16" />
          <VerticalLayout height="90" >
            <Label text="ПУТЬ К WARCRAFT 3 (*)"  tooltip="Укажите путь к игре которая будет использоваться с редактором KFWE" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <Control height="8" />
              <HorizontalLayout class="Background" childpadding="6" >
                <Button text="Path" width="40" height="20" font="2" name="choose_war3_dir" />
                <Label text="" bkimage="file='Common/kf/field.png' corner='8,8,8,8'" textcolor="#FFE4E6EB" font="2" textpadding="10,0,10,0" align="left" height="30" name="Warcraft3Directory" />
              </HorizontalLayout>
            </VerticalLayout>
          </VerticalLayout>
          <Control height="16" />
          <VerticalLayout height="110" >
            <Label text="РЕЕСТР"  tooltip="Меняет реестр игры" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <CheckBox text="Разрешить Локальные Файлы"   width="294" name="AllowLocalFiles" tooltip="Это используется например для того чтобы загружать безкодовые сохранения в rpg картах." />
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
        <VerticalLayout class="Background" inset="24,14,20,14" >
          <VerticalLayout height="170" >
            <Label text="ЯЗЫК(*)" tooltip= "Выбрать язык конфига" class="LabelTitle" />
            <VerticalLayout class="Background" inset="10,6,10,6" >
              <RadioButton class="NormalRadioButton" text="Русский" width="212" group="Language" name="Language-zh-CN" />
              <RadioButton class="NormalRadioButton" text="Английский" width="212" group="Language" name="Language-en-US" />
            </VerticalLayout>
          </VerticalLayout>
        </VerticalLayout>
      </TabLayout>
    </HorizontalLayout>
    <HorizontalLayout bkcolor="#FF17181C" height="30" inset="24,8,24,0" >
      <Label text="Опции помеченные (*) требуют перезапуск KFWE чтобы начать действовать." textcolor="#FF7D8290" font="2" align="left" />
    </HorizontalLayout>
    <HorizontalLayout bkcolor="#FF17181C" height="60" childpadding="10" inset="24,10,24,16" >
      <Control />
      <Button text="Сброс" width="104" height="34" name="reset" />
      <Button text="Ок" width="104" height="34" name="ok" textcolor="#FFFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#FFFFFFFF" normalimage="file='Common/kf/btn_pri.png' corner='9,9,9,9'" hotimage="file='Common/kf/btn_pri_hot.png' corner='9,9,9,9'" pushedimage="file='Common/kf/btn_pri_push.png' corner='9,9,9,9'" />
      <Button text="Отмена" width="104" height="34" name="cancel" />
    </HorizontalLayout>
  </VerticalLayout>
</Window>
